# LOCAL DEVELOPMENT ONLY. scripts/init-env generates a random password.
# Do not commit .env or paste its contents into a conversation.
CL_ENVIRONMENT=development
CL_ENABLE_DEVELOPMENT_TOOLS=true
# Each repository report requires an explicit signed-in public-read confirmation.
# Set false to permit only existing authorized imports/manual draft work.
CL_REPOSITORY_PUBLIC_READS_ENABLED=true
CL_DB_NAME=contribution_ledger
CL_DB_USER=contribution_ledger
CL_DB_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD
CL_WEB_PORT=5173
CL_API_PORT=8000

# Optional GitHub profile: these identifiers are not credentials. Leave blank for manual-only use.
# Actual credentials go in .local/github-secrets/; see docs/github_setup.md.
CL_GITHUB_APP_ID=
CL_GITHUB_CLIENT_ID=
CL_GITHUB_AUTHORIZATION_HOURS=24
CL_GITHUB_PROJECT_QUOTA_BYTES=134217728

# Optional phase-9 synchronization. Normal startup remains manual-only.
# Run scripts/sync.ps1 -Action init (or sync.sh init) to append a separately
# generated CL_JOBS_BROKER_PASSWORD to your actual .env. Do not use a placeholder.
# Only enable signed intake after provisioning github-webhook-secret privately:
# CL_GITHUB_WEBHOOK_ENABLED=true
# CL_WEBHOOK_PORT=8010

# Phase 10: optional customer-controlled AI (default off). Never put provider API keys here.
# scripts/ai.ps1 init adds a SEPARATE generated CL_AI_DB_PASSWORD locally.
CL_AI_DEPLOYMENT_MODE=disabled
CL_AI_LIVE_ENABLED=false
CL_AI_PAID_PROBES_ENABLED=false
CL_AI_PERMITTED_PROVIDERS=[]

# Phase 11: separate opt-in for disclosing reviewed project text to live providers.
CL_AI_EVIDENCE_ENABLED=false
