.git
.env
.env.*
!.env.example
**/.venv
**/__pycache__
**/.pytest_cache
**/node_modules
**/dist
**/.test-build
**/test-results
**/playwright-report
.local
secrets
uploads
*.zip
*.pem
*.key
*.dump

# Native development artifacts may be below apps/api, not just the repository root.
**/.local/
**/evidence-data/

# Operator-provisioned GitHub secrets must not enter source or build contexts.
*.pem
github-client-secret
.local/github-secrets/

# The Python SecretStore package is source, not an operator credential directory.
!apps/api/app/security/secrets
!apps/api/app/security/secrets/**

# Optional webhook signing key: protect outside any staging directory as well.
github-webhook-secret

# Operator recovery artifacts never belong in an image build context.
*.clb
*.sqlite
*.sqlite3
*.tar

# Compiled personal Windows runtime is a distribution artifact, not source.
/runtime/
/runtime-manifest.json

# Match source-control protections for private personal/operator state.
**/secrets/
!apps/api/app/security/secrets/
apps/api/app/security/secrets/**
!apps/api/app/security/secrets/*.py
**/personal-data/
**/postgres-data/
**/pg_wal/
**/pg_tblspc/
**/auth-master/
**/ai-master/
**/ai-credentials/
**/github-secrets/
**/github-master/
**/github-credentials/
**/local-data/
**/backups/
**/exports/
!apps/api/app/finance/exports/
apps/api/app/finance/exports/**
!apps/api/app/finance/exports/*.py
**/logs/
**/uploads/
**/postgres-password.txt
**/personal-installation.json
**/processes.json
**/ports.json
**/*.db
**/*.db-*
**/*.sqlite-*
**/*.sqlite3-*
