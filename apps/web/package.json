{
  "name": "contribution-ledger-web",
  "version": "0.17.8",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "node server.mjs",
    "test": "tsc -p tsconfig.test.json && node --test tests/*.test.mjs",
    "test:server": "node --test tests/server.test.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.2",
    "typescript": "5.8.3",
    "vite": "8.3.3"
  },
  "overrides": {
    "source-map-js": "1.2.2"
  }
}
